# FoodSave configuration
# For local development, copy this file to .env and fill in your values.
# NEVER commit the real .env file.

DB_HOST=localhost
DB_NAME=foodsave_db
DB_USER=root
DB_PASSWORD=

# Google Maps JavaScript API key.
# Create a restricted key in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# JWT signing secret. Use a long random value in real deployments.
JWT_SECRET=change-this-to-a-long-random-secret

# Optional: comma-separated browser origins allowed to call the API.
# Example: http://localhost/FoodSave,http://localhost
API_ALLOWED_ORIGINS=http://localhost
